generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth_db"]
}

enum UserType {
  USER
  CLUB

  @@schema("auth_db")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  userType  UserType @default(USER)

  bio       String?
  avatarUrl String? @default("default-avatar.jpeg")
  coverUrl  String? @default("default-cover.jpeg")

  createdAt DateTime @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  @@schema("auth_db")
}